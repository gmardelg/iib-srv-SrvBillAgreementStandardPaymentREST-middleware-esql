BROKER SCHEMA co.com.bancopopular.payment.cnv
/*****************************************************************************
Módulo encargado del procesamiento del mensaje del servicio especifico
para la notificacion de recaudos asociados a un convenio. Este servicio
estándar para banco Popular, notifica el pago de conceptos asociados a
un convenio. El método POST /Notify habilita el recaudo desde el canal
de oficinas (Sofia), por medio de la lectura del código de barras.
Autor		: Yesid Briceño
*****************************************************************************/
CREATE COMPUTE MODULE BillAgreementPayment_Req
	
	/*****************************************************************************
	Esta función procesa una petición REST request en el IBM Integration Bus usando
	ESQL. Prepara la estructura del mensaje de salida para la notificacíon de recaudos
	asociados a un convenio. Este servicio estándar para banco realiza la integración
	entre el canal de oficinas y el Back-End expuesto por el convenio.
	Se extrae y almacena la información relevante de la cabecera y el cuerpo, para
	construir la petición hacia el Back-End y el registro de logs para auditoria.
	*****************************************************************************/
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		/* Paso de cabeceras de mensaje */
		CALL CopyMessageHeaders();
		
		/* Crear Árbol Para El Entorno Local Destination.REST.Request */
		CREATE FIELD OutputLocalEnvironment.Destination.REST.Request;
		
		/* Referencias de control de mensajeria */
		DECLARE refEnv			REFERENCE TO Environment;
		DECLARE refMQRFH2 		REFERENCE TO OutputRoot.MQRFH2;
		DECLARE refInputHdr		REFERENCE TO InputRoot.MQRFH2.usr.msgOrig.Data.Headers;
		DECLARE refOutputHdr	REFERENCE TO OutputLocalEnvironment.Destination.REST.Request;
		DECLARE refService		REFERENCE TO OutputRoot.MQRFH2.usr.service.serviceList;
		
		/******************************************************/
		-- Informacion para Auditoria
		/******************************************************/
		--> IDLog Nº2
		SET refMQRFH2.usr.log.idLog				= CTE_IDLOG_2;
		CALL co.com.bancopopular.common.procedures.createMsgLogs(refMQRFH2, CTE_IDLOG_2, refMQRFH2.usr.log.nameSrv, CTE_SERVICE_TYPE);
		--> Nombre Del Servicio BUS
		SET refMQRFH2.usr.log.nameApplication	= CTE_APPLICATION;
		
		/* Establecer nombre del proveedor y aplicación */
		SET refMQRFH2.usr.log.nmProvider		= CTE_PROVIDER;
		SET refMQRFH2.usr.log.nameSrv			= CTE_OPERATION;
		
		/* Crear mensaje para Auditoria */
		SET OutputRoot.JSON.Data 			= InputRoot.JSON.Data.Body;
		
		/* Guardar cabeceras */
		CALL co.com.bancopopular.common.procedures.saveMQM(InputRoot,refEnv,CTE_IDLOG_2);
		
		/* valor = CAST Amt AS DECIMAL */
		DECLARE valor DECIMAL;
		SET valor = CAST( InputRoot.JSON.Data.Body.InvoiceInfo.Amt AS DECIMAL);
		
		/* CAST Amt AS INTEGER OR DECIMAL msgOrig */
		IF POSITION('.' IN CAST(valor AS CHAR)) > CTE_ZERO THEN
		    -- El valor tiene decimales, envíalo tal cual
		    SET OutputRoot.JSON.Data.InvoiceInfo.Amt = valor;
		ELSE
		    -- El valor no tiene decimales, envíalo sin decimales
		    SET OutputRoot.JSON.Data.InvoiceInfo.Amt = CAST(valor AS INTEGER);
		END IF;
			
		/* Definir PmtReferences como JSON array message */
		CREATE FIELD OutputRoot.JSON.Data.PmtReferences IDENTITY(JSON.Array)PmtReferences;
		
		/* Envío para auditoría */
		PROPAGATE TO TERMINAL 'out1' DELETE NONE;
		
		/******************************************************/
		-- Creación mensaje para Backend
		/******************************************************/
		--> Header
		SET refOutputHdr.Parameters								= refInputHdr;
		SET refOutputHdr.Parameters."X-Rquid"					= NULL;
		SET refOutputHdr.Parameters."X-Original-HTTP-Command"	= NULL;
		--> Body: Previamente mapeado para enviar a BD AUDITORIA
		
		/*Extraer información de archivo de configuración
		  para el nodo rest request: baseurl y timeout*/
        SET refOutputHdr.BaseURL = refService.service[2].baseURL;
		SET refOutputHdr.Timeout = CAST(refService.service[2].timeOut AS INTEGER);
		
		/* NULL TransactionFC */
		SET refMQRFH2.usr.TransactionFC = NULL;
		RETURN TRUE;
	END;

	CREATE PROCEDURE CopyMessageHeaders() BEGIN
		DECLARE I INTEGER 1;
		DECLARE J INTEGER;
		SET J = CARDINALITY(InputRoot.*[]);
		WHILE I < J DO
			SET OutputRoot.*[I] = InputRoot.*[I];
			SET I = I + 1;
		END WHILE;
	END;
END MODULE;


CREATE COMPUTE MODULE BillAgreementPayment_Resp
	
	/*****************************************************************************
	Esta función procesa la respuesta del servicio REST BillAgreementStandardPayment.
	Mapea los encabezados de los mensajes, gestiona la información de auditoría y
	construye el cuerpo de la respuesta JSON para la fachada/orquestador del servicio.
	El módulo gestiona tanto las respuestas correctas como las incorrectas, 
	configurando los códigos de estado, las descripciones e información de estado
	adicional correspondientes. También gestiona los encabezados MQMD y MQRFH2 para el
	control de mensajes y la auditoría.
	*****************************************************************************/			
	CREATE FUNCTION Main() RETURNS BOOLEAN
	BEGIN
		
		/* Mapeo de cabeceras del mensaje */
		SET OutputRoot.Properties 	= InputRoot.Properties;
		-- Recuperar Cabecera MQMD del Environment.
		SET OutputRoot.MQMD			= Environment.Variables.headers.MQMD;
		-- Recuperar Cabecera MQRFH2 del Environment.
		SET OutputRoot.MQRFH2 		= Environment.Variables.headers.MQRFH2;
		
		/* Referencias de control de mensajeria */
		DECLARE refEnv		REFERENCE TO Environment;
		DECLARE refMQRFH2	REFERENCE TO OutputRoot.MQRFH2;
		DECLARE refInputMsg	REFERENCE TO InputRoot.JSON.Data;
		DECLARE refHeader	REFERENCE TO InputRoot.HTTPResponseHeader;
		DECLARE refInputAdd REFERENCE TO InputRoot.JSON.Data.MsgRsHdr.Status.AdditionalStatus;
		DECLARE refInputHdr	REFERENCE TO OutputRoot.MQRFH2.usr.msgOrig.Data.Headers;
		
		/******************************************************/
		-- Informacion para Auditoria
		/******************************************************/
		--> IDLog Nº3
		SET refMQRFH2.usr.log.idLog				= CTE_IDLOG_3;
		CALL co.com.bancopopular.common.procedures.createMsgLogs(refMQRFH2, CTE_IDLOG_3, refMQRFH2.usr.log.nameSrv, CTE_SERVICE_TYPE);
		--> Nombre Del Servicio BUS
		SET refMQRFH2.usr.log.nameApplication	= CTE_APPLICATION;
		
		/* Establecer nombre del proveedor y aplicación */
		SET refMQRFH2.usr.log.nmProvider		= CTE_PROVIDER;
		SET refMQRFH2.usr.log.nameSrv			= CTE_OPERATION;
		
		/* Body del mensaje JSON Para Auditoria */
		SET OutputRoot.JSON.Data  				= refInputMsg;
		
		/* Envío para auditoría */
		PROPAGATE TO TERMINAL 'out1' DELETE NONE;
		
		/* NULL OutputRoot.JSON */
		SET OutputRoot.JSON = NULL;
		
		/* Header y Body del mensaje Json */
		CREATE FIELD OutputRoot.JSON.Data.Headers;
		CREATE FIELD OutputRoot.JSON.Data.Body.MsgRsHdr;
		
		/* Referencias de control de mensajeria */
		DECLARE refMsHeader		REFERENCE TO OutputRoot.JSON.Data.Headers;
		DECLARE refMsgOut		REFERENCE TO OutputRoot.JSON.Data.Body.MsgRsHdr;
		DECLARE	refStatusCode	REFERENCE TO refInputMsg.MsgRsHdr.Status.StatusCode;

		/******************************************************/
		-- Crear mensaje response para la Fachada
		/******************************************************/
		DECLARE codResp CHARACTER '';
		
		/* Validar respuesta exitosa del backend */
		IF (EXISTS (InputRoot.JSON[]) AND FIELDVALUE (refStatusCode) = CTE_SUCCESSFUL) THEN

			/* Header */
			SET refMsHeader."X-RqUID"								= refInputHdr."X-RqUID"	;
			SET refMsHeader."X-ApprovalId"							= COALESCE(InputRoot.HTTPResponseHeader."X-ApprovalId",refInputHdr."X-RqUID");
			
			/* Body */
			
			/*-- Inicio de la Cabecera estándar MsgRsHdr --*/
			SET refMsgOut.Status.StatusCode							= CTE_SUCCESSFUL;
			SET refMsgOut.Status.Severity							= CTE_SEVERIDAD;
			SET refMsgOut.Status.StatusDesc							= CTE_DESCRIPTION;
			
			/*-- Mapear AdditionalStatus --*/
			SET refMsgOut.Status.AdditionalStatus.ServerStatusCode	= refInputAdd.ServerStatusCode;
			SET refMsgOut.Status.AdditionalStatus.Severity			= CTE_SEVERIDAD;
			SET refMsgOut.Status.AdditionalStatus.StatusDesc		= refInputAdd.StatusDesc;
			
			/*-- Mapear EndDt --*/
			SET refMsgOut.Status.EndDt								= TIMEFORMAT();
		ELSE
			
			/* Header */
			SET refMsHeader."X-RqUID"								= refInputHdr."X-RqUID"	;
			SET refMsHeader."X-ApprovalId"							= CTE_SUCCESSFUL;
			
			/* EXISTS ResponseFault[] */
			IF EXISTS (InputRoot.JSON.Data.ResponseFault[]) THEN
				
				/* Body */
				SET refMsgOut.Status.StatusCode							= CTE_ERROR;
				SET refMsgOut.Status.Severity							= CTE_SEVERITY_ERROR;
				SET refMsgOut.Status.StatusDesc 						= CTE_DESCRIPTION_ERROR1;
				
				/*-- Mapear AdditionalStatus --*/
				SET refMsgOut.Status.AdditionalStatus.ServerStatusCode	= CTE_ERROR;
				SET refMsgOut.Status.AdditionalStatus.Severity			= CTE_SEVERITY_ERROR;
				SET refMsgOut.Status.AdditionalStatus.StatusDesc		= CTE_DESCRIPTION_ERROR1;
				
				/* Petición incorrecta 400 */
				SET refMQRFH2.usr.response.WS.replyStatusCode			= CTE_HTTP_400;
			ELSE
				
				/* Body */
				SET refMsgOut.Status.StatusCode							= CTE_CODE_ERROR;
				SET refMsgOut.Status.Severity							= CTE_SEVERITY_ERROR;
				SET refMsgOut.Status.StatusDesc 						= CTE_DESCRIPTION_ERROR;
				
				/*-- Mapear AdditionalStatus --*/
				SET refMsgOut.Status.AdditionalStatus.ServerStatusCode	= COALESCE(refInputAdd.ServerStatusCode,CTE_HTTP_400);
				SET refMsgOut.Status.AdditionalStatus.Severity			= CTE_SEVERITY_ERROR;
				SET refMsgOut.Status.AdditionalStatus.StatusDesc		= COALESCE(refInputAdd.StatusDesc,CTE_DESCRIPTION_ERROR);
				
				/* Error de negocio 206 */
				SET refMQRFH2.usr.response.WS.replyStatusCode 			= CTE_HTTP_206;
			END IF;
			
			/*-- Mapear EndDt --*/
			SET refMsgOut.Status.EndDt									= TIMEFORMAT();
		END IF;
		
		/* Variable de estado */
		SET refMQRFH2.usr.CONVENIO = TRUE;
		SET	refMQRFH2.usr.CreateTX = FALSE;
		RETURN TRUE;
	END;
END MODULE;