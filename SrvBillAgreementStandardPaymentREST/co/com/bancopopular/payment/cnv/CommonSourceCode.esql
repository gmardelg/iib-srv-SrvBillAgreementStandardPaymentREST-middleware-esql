	-- Función TIMEFORMAT()
	CREATE FUNCTION TIMEFORMAT()RETURNS CHARACTER
	BEGIN
		RETURN CAST(CURRENT_TIMESTAMP AS CHARACTER FORMAT 'yyyy-MM-dd''T''HH:mm:ss:SS');
	END;